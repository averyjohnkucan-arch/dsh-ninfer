+  const auto& input=plane?v:k;const long long src=256LL*(h+kh*(t+total*b))+g*32;
+  float lo=input[src],hi=lo;for(int i=1;i<32;++i){lo=std::min(lo,input[src+i]);hi=std::max(hi,input[src+i]);}
