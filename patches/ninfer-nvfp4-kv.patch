+ }
+ std::cout<<(five?"q5_1":"q6_0")<<" heads="<<qh<<" width="<<width<<" batch="<<batch<<" base="<<base<<" worst="<<worst<<" failures="<<failures<<"\n";return failures;
+}
+}
+int main(){if(cuda_unavailable())return 77;int failures=0;for(auto s:{KvCacheStorage::AffineQ5_1Group32,KvCacheStorage::SymmetricQ6_0Group32})for(int heads:{16,24})for(int w:{1,7,16,17,65})failures+=trial(s,w,w<=16?2:1,63,heads);return failures?1:0;}
