+  const int dst=d+256*(h+kh*(t+width*b)),src=d+256*(h+kh*(base+t+total*b));queryk[dst]=bf16_to_f32(f32_to_bf16(k[src]+0.375f));queryv[dst]=bf16_to_f32(f32_to_bf16(v[src]-0.625f));
+  // Replacing previously speculative rows must update the represented cache. Masked
+  // rows retain their previous bytes, as they do after a rejected speculative suffix.
+  if(t<counts[b]){k[src]=queryk[dst];v[src]=queryv[dst];}}
+ auto qk=to_device_bf16(queryk),qv=to_device_bf16(queryv);
+ Tensor qkt(qk.p,DType::BF16,{256,kh,width,batch}),qvt(qv.p,DType::BF16,{256,kh,width,batch});
+ ops::causal_softmax_attention(qt,qkt,qvt,qpt,qct,rt,{256,qh,kh},0.0625f,cache,{unsigned(base+1),unsigned(total)},workspace,ot,nullptr);cuda_synchronize();
+ codesk=from_device<std::uint8_t>(kc,kc.bytes);codesv=from_device<std::uint8_t>(vc,vc.bytes);
+ scalesk=from_device<std::uint16_t>(ks,ks.bytes/2);scalesv=from_device<std::uint16_t>(vs,vs.bytes/2);
+ verify_encoder();
+ auto actual=from_device_bf16(out,q.size());double worst=0;
+ for(int b=0;b<batch;++b)for(int h=0;h<qh;++h)for(int t=0;t<width;++t){
+  const int end=querypos[b*width+t]+1;std::vector<double> scores(end);double m=-INFINITY;
+  for(int j=0;j<end;++j){double sum=0;for(int d=0;d<256;++d)sum+=q[d+256*(h+qh*(t+width*b))]*decode(false,b,h/(qh/kh),j,d);scores[j]=sum*.0625;m=std::max(m,scores[j]);}
