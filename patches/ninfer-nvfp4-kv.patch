diff --git a/src/ops/kv_cache/packed56.cu b/src/ops/kv_cache/packed56.cu
new file mode 100644
index 0000000..ffa1dc0
--- /dev/null
+++ b/src/ops/kv_cache/packed56.cu
@@ -0,0 +1,138 @@
+#include "ops/kv_cache/packed56.h"
+#include "ops/common/device_tier.h"
+#include "ops/kv_cache/packed56.cuh"
+#include "ops/kv_cache/d256_profile.h"
+#include "ops/softmax_attention/dense/causal_cache/prompt_bf16.cuh"
+#include "ops/softmax_attention/dense/causal_cache/geometry.cuh"
+#include "core/device.h"
+#include <cmath>
+#include <algorithm>
+namespace ninfer::ops::detail {
+namespace {
+template<int Bits> __global__ void append_kernel(const __nv_bfloat16* k,const __nv_bfloat16* v,
+        const int* pos,const int* valid,const int* rows,const int* tables,int stride,int width,int heads,
+        unsigned char* kc,unsigned char* vc,__half* ks,__half* vs) {
+    const int token=blockIdx.x,head=blockIdx.y,batch=blockIdx.z,group=threadIdx.x;
+    if(group>=8 || (valid && token>=valid[batch]))return;
+    const int p=pos[token+width*batch];
+    const int page=tables[(rows?rows[batch]:batch)*stride+(p>>6)];
+    const long long row=(p&63)+64LL*(head+heads*page);
+    constexpr int nbytes=Bits*4,sc=Bits==5?16:8;
+    for(int plane=0;plane<2;++plane) {
+        const auto* input=(plane?v:k)+256LL*(head+heads*(token+width*batch))+group*32;
+        auto* codes=(plane?vc:kc)+row*(Bits*32)+group*nbytes;
+        auto* scales=(plane?vs:ks)+row*sc+group*(Bits==5?2:1);
+        float lo=__bfloat162float(input[0]),hi=lo;
+        for(int i=1;i<32;++i){float x=__bfloat162float(input[i]);lo=fminf(lo,x);hi=fmaxf(hi,x);}
+        float s;float m=0;
+        if constexpr(Bits==5){scales[1]=__float2half_rn(lo);m=__half2float(scales[1]);s=(hi-m)/31.f;}
+        else{s=fmaxf(fabsf(lo),fabsf(hi))/31.f;}
+        scales[0]=__float2half_rn(s);s=__half2float(scales[0]);
+        unsigned q[32];
+        for(int i=0;i<32;++i) {
+            int z=s>0?__float2int_rn((__bfloat162float(input[i])-m)/s):0;
+            if constexpr(Bits==5)z=max(0,min(31,z));else z=max(-31,min(31,z));
+            q[i]=unsigned(z)&((1u<<Bits)-1);
+        }
+        for(int b=0;b<nbytes;++b) {
+            const int i=(b*8)/Bits,shift=b*8-i*Bits;
+            unsigned word=q[i]>>shift;
+            if(i+1<32)word|=q[i+1]<<(Bits-shift);
+            if(i+2<32 && Bits-shift+Bits<8)word|=q[i+2]<<(2*Bits-shift);
+            codes[b]=word&255;
+        }
+    }
+}
+// Split-KV decode/verification: eight warps each own one output dimension group.
+// Every partial is computed in FP32 from the stored codec and merged with stable softmax.
+template<int Bits> __global__ void attention_split(const __nv_bfloat16* q,const int* pos,
+        const int* valid,const int* rows,const int* tables,int stride,int width,int qh,int kh,
+        Packed56Plane<Bits> k,Packed56Plane<Bits> v,int splits,float scale,float* partial) {
+    const int token=blockIdx.x%width,batch=blockIdx.x/width,head=blockIdx.y;
+    const int lane=threadIdx.x&31,split=blockIdx.z*8+(threadIdx.x>>5);
+    if(split>=splits)return;
+    const long long pi=((blockIdx.x*qh+head)*splits+split)*258LL;
+    const bool active=!valid || token<valid[batch];
+    const int end=active?pos[token+width*batch]+1:0;
+    const int begin=(end*1LL*split)/splits,stop=(end*1LL*(split+1))/splits;
+    const int h=head/(qh/kh);
+    float query[8],acc[8]={};
+    #pragma unroll
+    for(int i=0;i<8;++i)query[i]=__bfloat162float(q[lane+32*i+256LL*(head+qh*(token+width*batch))]);
+    float m=-INFINITY,l=0;
+    for(int t=begin;t<stop;++t) {
+        const int page=tables[(rows?rows[batch]:batch)*stride+(t>>6)];
+        float dot=0;
+        #pragma unroll
+        for(int i=0;i<8;++i)dot+=query[i]*k.load(page,h,t&63,lane+32*i);
+        #pragma unroll
+        for(int step=16;step;step/=2)dot+=__shfl_xor_sync(0xffffffff,dot,step);
+        const float score=dot*scale,n=fmaxf(m,score),a=expf(m-n),b=expf(score-n);
+        #pragma unroll
+        for(int i=0;i<8;++i)acc[i]=acc[i]*a+b*v.load(page,h,t&63,lane+32*i);
+        l=l*a+b;m=n;
+    }
+    #pragma unroll
+    for(int i=0;i<8;++i)partial[pi+lane+32*i]=acc[i];
+    if(lane==0){partial[pi+256]=m;partial[pi+257]=l;}
+}
+__global__ void merge_split(const float* partial,int width,int heads,int splits,__nv_bfloat16* out) {
+    const int row=blockIdx.x,head=blockIdx.y,d=threadIdx.x;
+    float m=-INFINITY;
+    for(int s=0;s<splits;++s)m=fmaxf(m,partial[((row*heads+head)*splits+s)*258LL+256]);
+    float acc=0,l=0;
+    for(int s=0;s<splits;++s){const auto* p=partial+((row*heads+head)*splits+s)*258LL;float a=p[257]>0?expf(p[256]-m):0;acc+=p[d]*a;l+=p[257]*a;}
+    out[d+256LL*(head+heads*row)]=__float2bfloat16_rn(l>0?acc/l:0);
+}
+struct PackedMetadata {
+ const int* tables;const int* valid;const int* rows;int stride;int fallback_row;
+ __device__ int valid_tokens(int width) const {return valid?max(0,min(width,*valid)):width;}
+ __device__ const int* block_table() const {return tables+stride*(rows?*rows:fallback_row);}
+};
+template<int Bits,class Geometry> void prompt_for(const Tensor& q,const Tensor& pos,
+        const Tensor& valid,const Tensor& rows,float scale,PagedKVBatchLayerView cache,Tensor& out,cudaStream_t stream) {
+    using M=PackedMetadata;
+    constexpr int smem=kCausalPromptBf16SmemBytes;
+    auto kernel=causal_attention_prompt_bf16_kernel<Geometry,M,Packed56Plane<Bits>>;
+    CUDA_CHECK(cudaFuncSetAttribute(kernel,cudaFuncAttributeMaxDynamicSharedMemorySize,smem));
+    for(int b=0;b<q.ne[3];++b){
+        M meta{static_cast<const int*>(cache.block_tables.data), valid.data?static_cast<const int*>(valid.data)+b:nullptr,
+               rows.data?static_cast<const int*>(rows.data)+b:nullptr,static_cast<int>(cache.block_tables.ne[0]),b};
+        // The unmasked variant supplies a valid count without a host/device copy.
+
+        const Packed56Plane<Bits> k{static_cast<const unsigned char*>(cache.k_pages.data),static_cast<const __half*>(cache.k_scale_pages.data),Geometry::KVHeads};
+        const Packed56Plane<Bits> v{static_cast<const unsigned char*>(cache.v_pages.data),static_cast<const __half*>(cache.v_scale_pages.data),Geometry::KVHeads};
+        kernel<<<dim3((q.ne[2]+63)/64,Geometry::QHeads),128,smem,stream>>>(
+            static_cast<const __nv_bfloat16*>(q.data)+256LL*Geometry::QHeads*q.ne[2]*b,k,v,meta,
+            static_cast<const int*>(pos.data)+q.ne[2]*b,scale,
+            static_cast<__nv_bfloat16*>(out.data)+256LL*Geometry::QHeads*q.ne[2]*b,q.ne[2]);
+    }
+}
+template<int Bits> void attention_for(const Tensor& q,const Tensor& pos,const Tensor& valid,const Tensor& rows,
+        float scale,PagedKVBatchLayerView cache,unsigned keys,WorkspaceArena& workspace,Tensor& out,cudaStream_t stream) {
+    if(q.ne[2]>16){
+        if(q.ne[1]==16)prompt_for<Bits,CausalD256H16Kv2>(q,pos,valid,rows,scale,cache,out,stream);
+        else prompt_for<Bits,CausalD256H24Kv4>(q,pos,valid,rows,scale,cache,out,stream);
+    } else {
+        const int splits=std::max(1,std::min(64,int((keys+255)/256)));
+        auto temp=workspace.alloc(DType::FP32,{258,splits,q.ne[1],q.ne[2]*q.ne[3]},256);
+        Packed56Plane<Bits> k{static_cast<const unsigned char*>(cache.k_pages.data),static_cast<const __half*>(cache.k_scale_pages.data),int(cache.num_kv_heads)};
+        Packed56Plane<Bits> v{static_cast<const unsigned char*>(cache.v_pages.data),static_cast<const __half*>(cache.v_scale_pages.data),int(cache.num_kv_heads)};
+        attention_split<Bits><<<dim3(q.ne[2]*q.ne[3],q.ne[1],(splits+7)/8),256,0,stream>>>(
+            static_cast<const __nv_bfloat16*>(q.data),static_cast<const int*>(pos.data),static_cast<const int*>(valid.data),static_cast<const int*>(rows.data),
+            static_cast<const int*>(cache.block_tables.data),cache.block_tables.ne[0],q.ne[2],q.ne[1],cache.num_kv_heads,k,v,splits,scale,static_cast<float*>(temp.data));
+        merge_split<<<dim3(q.ne[2]*q.ne[3],q.ne[1]),256,0,stream>>>(static_cast<const float*>(temp.data),q.ne[2],q.ne[1],splits,static_cast<__nv_bfloat16*>(out.data));
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+}
+std::size_t packed56_workspace(int heads,int width,int batch){return std::size_t(258)*64*heads*std::min(width,16)*batch*4+256;}
+void packed56_append(const Tensor& k,const Tensor& v,const Tensor& pos,const Tensor& valid,const Tensor& rows,PagedKVBatchLayerView c,cudaStream_t stream){
+    const auto issue=[&]<int Bits>(){append_kernel<Bits><<<dim3(k.ne[2],k.ne[1],k.ne[3]),32,0,stream>>>(static_cast<const __nv_bfloat16*>(k.data),static_cast<const __nv_bfloat16*>(v.data),static_cast<const int*>(pos.data),static_cast<const int*>(valid.data),static_cast<const int*>(rows.data),static_cast<const int*>(c.block_tables.data),c.block_tables.ne[0],k.ne[2],k.ne[1],static_cast<unsigned char*>(c.k_pages.data),static_cast<unsigned char*>(c.v_pages.data),static_cast<__half*>(c.k_scale_pages.data),static_cast<__half*>(c.v_scale_pages.data));};
+    if(c.storage==KvCacheStorage::AffineQ5_1Group32)issue.template operator()<5>();else issue.template operator()<6>();
+    CUDA_CHECK(cudaGetLastError());
+}
+void packed56_attention(const Tensor& q,const Tensor& p,const Tensor& valid,const Tensor& rows,float scale,PagedKVBatchLayerView c,unsigned keys,WorkspaceArena& w,Tensor& out,cudaStream_t s){
+    if(c.storage==KvCacheStorage::AffineQ5_1Group32)attention_for<5>(q,p,valid,rows,scale,c,keys,w,out,s);else attention_for<6>(q,p,valid,rows,scale,c,keys,w,out,s);
+}
+}
diff --git a/src/ops/kv_cache/packed56.cuh b/src/ops/kv_cache/packed56.cuh
new file mode 100644
index 0000000..d943add
--- /dev/null
+++ b/src/ops/kv_cache/packed56.cuh
@@ -0,0 +1,43 @@
+#pragma once
+#include "ops/kernel/paged_kv_address.cuh"
+#include "ops/softmax_attention/dense/causal_cache/prompt_common.cuh"
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+namespace ninfer::ops {
+// NInfer's packed G32 affine-five / symmetric-six formats. Little-endian bitstream,
+// independent for each 32-element group; FP16 scales (and Q5_1 offsets) are separate planes.
+template<int Bits> struct Packed56Plane {
+    const unsigned char* codes;
+    const __half* scales;
+    int heads;
+    static constexpr int Bytes=256*Bits/8;
+    static constexpr int Scales=Bits==5?16:8;
+    __device__ float load(int page,int head,int offset,int d) const {
+        const long long row=offset+64LL*(head+heads*page);
+        const int bit=d*Bits, b=bit/8, shift=bit%8;
+        const auto* p=codes+row*Bytes;
+        unsigned raw=p[b];
+        if(shift+Bits>8) raw|=unsigned(p[b+1])<<8;
+        int q=(raw>>shift)&((1<<Bits)-1);
+        if constexpr(Bits==5) {
+            const float s=__half2float(scales[row*Scales+(d/32)*2]);
+            const float m=__half2float(scales[row*Scales+(d/32)*2+1]);
+            return __bfloat162float(__float2bfloat16_rn(__fadd_rn(__fmul_rn(float(q),s),m)));
+        } else {
+            q=q>=32?q-64:q;
+            return __bfloat162float(__float2bfloat16_rn(__fmul_rn(float(q),__half2float(scales[row*Scales+d/32]))));
+        }
+    }
+};
+// Decode only the current FlashAttention tile into shared memory; never expand the cache.
+template<class Geometry,int Bits>
+__device__ __forceinline__ void causal_prompt_stage_kv(__nv_bfloat16* dst,
+        Packed56Plane<Bits> cache,int head,int k0,int last,int page,int tid) {
+    for(int i=tid;i<kCausalPromptBc*256;i+=kCausalPromptThreads) {
+        const int t=i/256,d=i%256;
+        dst[t*256+causal_prompt_swz(t,d)]=__float2bfloat16_rn(
+            k0+t<=last?cache.load(page,head,(k0+t)&63,d):0.f);
+    }
+    __syncthreads();
+}
+}
