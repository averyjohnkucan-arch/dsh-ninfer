+// ---------------------------------------------------------------------------
+// Dynamic grouped conv prepare + finish.
+// ---------------------------------------------------------------------------
+int verify_dynamic_conv(const PackedWeight& kernel_projection, const PackedWeight& projection,
+                        std::int32_t width, std::int32_t batch, std::uint32_t seed) {
