+    std::vector<float> residual(columns * kHidden);
+    std::vector<float> norm(kHidden);
+    std::vector<float> base(kHidden * 4);
+    for (std::size_t column = 0; column < columns; ++column) {
+        for (std::int32_t row = 0; row < kHidden; ++row) {
